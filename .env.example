# ==========================================
# Nutrimind - Esempio configurazione locale
# ==========================================
# Copia questo file in .env.local e compila con i tuoi valori.
# NON committare mai .env.local nel repo.

# ==========================================
# AMBIENTE DEV
# ==========================================
ASPNETCORE_ENVIRONMENT=Development

# Supabase DEV
SUPABASE_DEV_URL=https://tcszsyzpvmsifclziujc.supabase.co
SUPABASE_DEV_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_DEV_SECRET_KEY=sb_secret_...
SUPABASE_DEV_JWKS_URL=https://tcszsyzpvmsifclziujc.supabase.co/auth/v1/.well-known/jwks.json

# Open Food Facts DEV (staging)
OFF_BASE_URI_DEV=https://world.openfoodfacts.net
OFF_USERNAME_DEV=off
OFF_PASSWORD_DEV=off
OFF_USER_AGENT_DEV=Nutrimind/0.1-dev (tua-email@example.com)

# ==========================================
# AMBIENTE PROD
# ==========================================
# ASPNETCORE_ENVIRONMENT=Production

# Supabase PROD
# SUPABASE_PROD_URL=https://ynnlfxgehbtlneiknrfr.supabase.co
# SUPABASE_PROD_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_PROD_SECRET_KEY=sb_secret_...
# SUPABASE_PROD_JWKS_URL=https://ynnlfxgehbtlneiknrfr.supabase.co/auth/v1/.well-known/jwks.json

# Open Food Facts PROD (production)
# OFF_BASE_URI_PROD=https://world.openfoodfacts.org
# OFF_USERNAME_PROD=off
# OFF_PASSWORD_PROD=off
# OFF_USER_AGENT_PROD=Nutrimind/0.1-prod (tua-email@example.com)
